# =============================================================================
# Positron (Pode Abrir) - environment template. Copy to .env and fill the blanks.
# =============================================================================

# -- Runtime -------------------------------------------------------------------
# development: HTTP origin, local PostgreSQL container, relaxed cookies.
# production : HTTPS origin, PostgreSQL with TLS verify-full, __Host- cookies.
APP_ENV=development
# Public origin users open in the browser (no trailing slash). In development
# this is the Vite dev server, which proxies /api to Django.
APP_ORIGIN=http://localhost:5190

# -- Local servers (start_server.py) ------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8030
FRONTEND_PORT=5190

# -- Secrets (generated by: python manage.py bootstrap_invite) ----------------
# VAULT_NAMESPACE salts every password-derived key: changing it makes existing
# accounts and encrypted exams unreadable. Preserve it across restores.
VAULT_NAMESPACE=
DJANGO_SECRET_KEY=
# Fernet key that encrypts the TOTP secrets at rest.
TOTP_ENCRYPTION_KEY=
# sha256 of the one-time invite for the first (staff) account.
BOOTSTRAP_INVITE_DIGEST=

# -- Local PostgreSQL (shared container agenda_ai_local_pg) -------------------
# Positron only ever uses PG_LOCAL_DATABASE (positron_db; browser tests use a
# disposable positron_e2e). Never point it at agenda_db.
PG_LOCAL_HOST=localhost
PG_LOCAL_PORT=55432
PG_LOCAL_USER=agenda
PG_LOCAL_PASSWORD=
PG_LOCAL_DATABASE=positron_db
PG_LOCAL_SSLMODE=disable

# -- Azure PostgreSQL (production only; set in App Service, not here) ---------
# POSTGRES_HOST=
# POSTGRES_PORT=5432
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_SSLROOTCERT=/etc/ssl/certs/ca-certificates.crt

# -- Product limits -------------------------------------------------------------
OWNER_SESSION_MINUTES=240
CONSULT_PAIR_MINUTES=5
CONSULT_ACCESS_MINUTES=45
ENROLLMENT_MINUTES=10
INVITATION_HOURS=72
PDF_MAX_MB=20
EXAM_PAGE_SIZE=50

# -- Email (SMTP, same mailbox as agenda_ai / Tennis OS for testing) ---------
# Invitations and password reset are sent by the worker (manage.py send_emails),
# started by start_server.py. With EMAIL_ENABLED=false, development prints the
# messages (and their links) in the [mailer] console instead.
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtpout.secureserver.net
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURITY=ssl
EMAIL_SMTP_USERNAME=leandro@tennisos.com.br
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=auth@tennisos.com.br
EMAIL_FROM_NAME=Pode Abrir
EMAIL_REPLY_TO=contato@tennisos.com.br
EMAIL_SMTP_TIMEOUT_SECONDS=20
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_SECONDS=60
EMAIL_PROCESSING_TIMEOUT_SECONDS=120
EMAIL_WORKER_INTERVAL_SECONDS=3
# Per-address cap for invitation / reset emails.
EMAIL_MAX_SENDS_PER_HOUR=5
PASSWORD_RESET_MINUTES=30

# -- Ephemeral access policy -------------------------------------------------
GRANT_MAX_MINUTES=10080
LINK_VIEW_MINUTES=30
LINK_PIN_MAX_FAILURES=5
HISTORY_WINDOW=200

# -- Web Push (installable app). Regenerate with: python manage.py generate_vapid
VAPID_SUBJECT=mailto:contato@podeabrir.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
